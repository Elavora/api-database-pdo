{
    "name": "elavora/api-database-pdo",
    "description": "Fabrica PDO opcional para o framework Elavora",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "elavora/api-framework": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Elavora\\Api\\Extension\\DatabasePdo\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "test": "@php vendor/bin/phpunit -c phpunit.xml",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@lint",
            "@test",
            "@analyse"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
